# =============================================================================
# Dockerfile.e2e — Quorum Dashboard browser E2E test runner
#
# PURPOSE
#   Runs the Playwright browser (@ui) E2E test suite inside an Alpine container.
#   Source code is bind-mounted at /workspace — nothing is baked in except the
#   Node.js runtime, pre-compiled node_modules, and system Chromium.
#
# WHY SYSTEM CHROMIUM
#   Playwright's bundled Chromium download is ~200MB. Installing system Chromium
#   via apk is lighter and already available for Alpine. PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
#   prevents the npm ci post-install step from downloading the bundled binary.
#
# NODE_MODULES STRATEGY
#   1. npm ci runs during build → node_modules live in the image layer
#   2. At runtime, source is bind-mounted at /workspace (host files overlay)
#   3. docker-compose.e2e.yml adds an anonymous volume at /workspace/node_modules
#   4. The anonymous volume shadows the host macOS binaries with Alpine-compiled ones
#   This prevents "Exec format error" from mixing macOS and Linux native modules.
#
# USAGE (via npm scripts from quorum-dash/)
#   npm run test:e2e:docker         # full run: start backend + dashboard + tests
#   npm run test:e2e:docker:up      # start backend + dashboard only
#   npm run test:e2e:docker:run     # run tests against a running stack
#   npm run test:e2e:docker:down    # stop everything
#   npm run test:e2e:docker:clean   # stop + wipe volumes (fresh state)
# =============================================================================

FROM node:24-alpine

# Skip Playwright's bundled Chromium download — we use the system binary below.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Install system Chromium and required shared libraries.
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-liberation

# Point Playwright at the system Chromium installed above.
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

ENV NODE_ENV=test

WORKDIR /workspace

# Install node_modules into the image layer (only rebuilt when lock file changes).
# Application source is bind-mounted at runtime — not baked in.
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Default: run all @ui specs. Override at runtime for targeted runs:
#   docker compose -f docker-compose.e2e.yml run --rm browser-test-runner \
#     npx playwright test --grep "S-14"
CMD ["npx", "playwright", "test"]
